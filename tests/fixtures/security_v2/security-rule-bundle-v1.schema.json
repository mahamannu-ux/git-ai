{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trackai.dev/contracts/security-v2/security-rule-bundle-v1.schema.json",
  "title": "TrackAI security rule bundle payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "bundle_version",
    "epoch",
    "issued_at",
    "numbat_pin",
    "compiler_version",
    "agents"
  ],
  "properties": {
    "schema_version": { "const": "trackai.security-rule-bundle/1" },
    "tenant_id": { "$ref": "#/definitions/opaqueId" },
    "bundle_version": { "$ref": "#/definitions/positiveSafeInteger" },
    "epoch": { "$ref": "#/definitions/positiveSafeInteger" },
    "issued_at": { "$ref": "#/definitions/utcTimestamp" },
    "numbat_pin": { "const": "20a5a52" },
    "compiler_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 27,
      "properties": {
        "claude-code": { "$ref": "#/definitions/agentBundle" },
        "cowork": { "$ref": "#/definitions/agentBundle" },
        "codex": { "$ref": "#/definitions/agentBundle" },
        "gemini-cli": { "$ref": "#/definitions/agentBundle" },
        "cursor": { "$ref": "#/definitions/agentBundle" },
        "windsurf": { "$ref": "#/definitions/agentBundle" },
        "copilot": { "$ref": "#/definitions/agentBundle" },
        "vscode": { "$ref": "#/definitions/agentBundle" },
        "opencode": { "$ref": "#/definitions/agentBundle" },
        "openclaw": { "$ref": "#/definitions/agentBundle" },
        "antigravity": { "$ref": "#/definitions/agentBundle" },
        "factory": { "$ref": "#/definitions/agentBundle" },
        "grok": { "$ref": "#/definitions/agentBundle" },
        "devin-cli": { "$ref": "#/definitions/agentBundle" },
        "hermes": { "$ref": "#/definitions/agentBundle" },
        "kimi-code": { "$ref": "#/definitions/agentBundle" },
        "pi": { "$ref": "#/definitions/agentBundle" },
        "qwen-code": { "$ref": "#/definitions/agentBundle" },
        "cline": { "$ref": "#/definitions/agentBundle" },
        "amp": { "$ref": "#/definitions/agentBundle" },
        "auggie": { "$ref": "#/definitions/agentBundle" },
        "kiro": { "$ref": "#/definitions/agentBundle" },
        "goose": { "$ref": "#/definitions/agentBundle" },
        "kilo": { "$ref": "#/definitions/agentBundle" },
        "openhands": { "$ref": "#/definitions/agentBundle" },
        "crush": { "$ref": "#/definitions/agentBundle" },
        "junie": { "$ref": "#/definitions/agentBundle" }
      }
    }
  },
  "definitions": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s]+$"
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "ruleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "ruleFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "content_b64"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "sha256": { "$ref": "#/definitions/sha256" },
        "content_b64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 349528,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "anyOf": [
            { "maxLength": 349524 },
            { "minLength": 349528, "maxLength": 349528, "pattern": "==$" }
          ]
        }
      }
    },
    "agentBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "enabled_rule_ids"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": { "$ref": "#/definitions/ruleFile" }
        },
        "enabled_rule_ids": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/ruleId" }
        }
      }
    }
  }
}
