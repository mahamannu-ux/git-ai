#!/bin/sh
set -eu

fail() {
  echo "Git AI PKG installation failed: $*" >&2
  exit 1
}

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
SOURCE_BINARY="$SCRIPT_DIR/git-ai"
NUMBAT_SOURCE="$SCRIPT_DIR/numbat"
NUMBAT_ADMIN_DIR="/Library/Application Support/TrackAI/Endpoint"
NUMBAT_BIN="$NUMBAT_ADMIN_DIR/bin/numbat"
CONSOLE_USER="$(/usr/bin/stat -f%Su /dev/console)"

case "$CONSOLE_USER" in
  ""|root|loginwindow|_mbsetupuser)
    fail "no valid console user is logged in"
    ;;
esac

[ -x "$SOURCE_BINARY" ] || fail "bundled git-ai binary is missing"
[ -x "$NUMBAT_SOURCE" ] || fail "bundled Numbat binary is missing"
[ -f "$SCRIPT_DIR/SHA256SUMS" ] || fail "Numbat SHA256SUMS is missing"
EXPECTED_SHA="$(/usr/bin/awk 'NF == 2 && $2 ~ /\/numbat$/ {print $1}' "$SCRIPT_DIR/SHA256SUMS")"
ACTUAL_SHA="$(/usr/bin/shasum -a 256 "$NUMBAT_SOURCE" | /usr/bin/awk '{print $1}')"
[ -n "$EXPECTED_SHA" ] && [ "$EXPECTED_SHA" = "$ACTUAL_SHA" ] || fail "Numbat SHA-256 mismatch"
/usr/bin/id "$CONSOLE_USER" >/dev/null 2>&1 || fail "console user $CONSOLE_USER does not exist"

USER_HOME="$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory | /usr/bin/awk 'NR == 1 { print $2 }')"
case "$USER_HOME" in
  /*) ;;
  *) fail "could not resolve the home directory for $CONSOLE_USER" ;;
esac

USER_GROUP="$(/usr/bin/id -gn "$CONSOLE_USER")"
GIT_AI_HOME="$USER_HOME/.git-ai"
GIT_AI_BIN_DIR="$GIT_AI_HOME/bin"
GIT_AI_BIN="$GIT_AI_BIN_DIR/git-ai"
SECURITY_DIR="$USER_HOME/.git-ai/internal/security"
RULES_DIR="$SECURITY_DIR/rules"
TRUST_DIR="$SECURITY_DIR/trust"

# Trust documents and a working no-match catalogue must exist before any hook
# is installed. The hook executes as the developer and uses literal $HOME.
/usr/bin/install -d -o "$CONSOLE_USER" -g "$USER_GROUP" -m 0755 "$GIT_AI_HOME" "$GIT_AI_HOME/internal"
/usr/sbin/chown "$CONSOLE_USER:$USER_GROUP" "$GIT_AI_HOME" "$GIT_AI_HOME/internal"
/usr/bin/install -d -o root -g wheel -m 0755 "$NUMBAT_ADMIN_DIR" "$NUMBAT_ADMIN_DIR/bin"
/usr/bin/install -o root -g wheel -m 0755 "$NUMBAT_SOURCE" "$NUMBAT_BIN"
BUILTIN_LIST="$(/usr/bin/mktemp -t trackai-numbat-rules)"
trap '/bin/rm -f "$BUILTIN_LIST"' EXIT
"$NUMBAT_BIN" rules list > "$BUILTIN_LIST" || fail "cannot list Numbat built-in rules"
/usr/bin/cmp -s "$BUILTIN_LIST" "$SCRIPT_DIR/builtin-rule-ids.txt" || fail "bundled Numbat built-in rules do not match the pinned list"
for notice in LICENSE THIRD_PARTY_LICENSES.txt PROVENANCE.txt SHA256SUMS agents.tsv; do
  /usr/bin/install -o root -g wheel -m 0644 "$SCRIPT_DIR/$notice" "$NUMBAT_ADMIN_DIR/$notice"
done
/usr/bin/install -d -o "$CONSOLE_USER" -g "$USER_GROUP" -m 0700 "$SECURITY_DIR" "$RULES_DIR" "$RULES_DIR/placeholder" "$TRUST_DIR"
while read -r numbat_agent source_agent; do
  [ -n "$numbat_agent" ] || continue
  folder="$RULES_DIR/placeholder/$source_agent"
  /usr/bin/install -d -o "$CONSOLE_USER" -g "$USER_GROUP" -m 0755 "$folder"
  /usr/bin/install -o "$CONSOLE_USER" -g "$USER_GROUP" -m 0644 "$SCRIPT_DIR/placeholder.yaml" "$folder/placeholder.yaml"
  while IFS= read -r id; do
    case "$id" in
      ""|*[!a-z0-9._-]*) fail "invalid pinned rule id" ;;
    esac
    path="$folder/builtin-$id.yaml"
    /usr/bin/printf 'id: %s\nversion: "1"\ntitle: TrackAI disables %s\nseverity: info\nexpr: '\''false'\''\nenabled: false\n' "$id" "$id" > "$path"
    /usr/sbin/chown "$CONSOLE_USER:$USER_GROUP" "$path"
    /bin/chmod 0644 "$path"
  done < "$SCRIPT_DIR/builtin-rule-ids.txt"
  "$NUMBAT_BIN" rules check --rules-dir "$folder" >/dev/null || fail "placeholder rule failed for $source_agent"
done < "$SCRIPT_DIR/agents.tsv"
if [ -e "$RULES_DIR/current" ] && [ ! -L "$RULES_DIR/current" ]; then
  fail "rules/current must be a symlink"
fi
/bin/rm -f "$RULES_DIR/current.next"
/bin/ln -s placeholder "$RULES_DIR/current.next"
/usr/sbin/chown -h "$CONSOLE_USER:$USER_GROUP" "$RULES_DIR/current.next"
# -h replaces the current symlink itself. Without it, BSD mv follows an
# existing current -> version directory and moves current.next inside it.
/bin/mv -fh "$RULES_DIR/current.next" "$RULES_DIR/current"
for document in "$SCRIPT_DIR/trust"/*.json; do
  [ -f "$document" ] || continue
  /usr/bin/install -o "$CONSOLE_USER" -g "$USER_GROUP" -m 0600 "$document" "$TRUST_DIR/$(/usr/bin/basename "$document")"
done
if [ -f "$SCRIPT_DIR/dev-pins.json" ]; then
  /usr/bin/install -o "$CONSOLE_USER" -g "$USER_GROUP" -m 0600 "$SCRIPT_DIR/dev-pins.json" "$SECURITY_DIR/dev-pins.json"
else
  /bin/rm -f "$SECURITY_DIR/dev-pins.json"
fi

/usr/bin/install -d -o "$CONSOLE_USER" -g "$USER_GROUP" -m 0755 "$GIT_AI_BIN_DIR"
/usr/sbin/chown "$CONSOLE_USER:$USER_GROUP" "$GIT_AI_BIN_DIR"
/usr/bin/install -o "$CONSOLE_USER" -g "$USER_GROUP" -m 0755 "$SOURCE_BINARY" "$GIT_AI_BIN"
/usr/bin/su - "$CONSOLE_USER" -c "\"$GIT_AI_BIN\" install-hooks"

# Numbat uses source-agent folder names from the signed bundle contract.
# Keep this mapping in one table; the managed configs retain literal $HOME.
while read -r numbat_agent source_agent; do
  [ -n "$numbat_agent" ] || continue
  "$NUMBAT_BIN" hook install --agent "$numbat_agent" --managed --emit all \
    --content preview --output file \
    --rules-dir "\$HOME/.git-ai/internal/security/rules/current/$source_agent" \
    --output-file '$HOME/.numbat/records.ndjson' || fail "managed hook install failed for $numbat_agent"
done < "$SCRIPT_DIR/agents.tsv"

/bin/date -u +%s > "$SECURITY_DIR/hooks-installed-at"
/usr/sbin/chown "$CONSOLE_USER:$USER_GROUP" "$SECURITY_DIR/hooks-installed-at"
/bin/chmod 0600 "$SECURITY_DIR/hooks-installed-at"

exit 0
